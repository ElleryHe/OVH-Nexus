# ==============================================================================
# OVH Nexus — Environment Configuration Template
# Copy this file to .env and set strong keys before starting:
#   cp .env.example .env
#
# Permissions & non-root privilege drop:
#   On boot, the container entrypoint automatically initializes /data (0700)
#   and drops privileges via su-exec to PUID:PGID (default 65532:65532).
#   No manual host `chown` on ./data is required.
# ==============================================================================

# [REQUIRED] Console login password & loopback API key (minimum 12 characters)
# Generate via: openssl rand -hex 24
API_SECRET_KEY=

# [REQUIRED] Independent master key for AES-256-GCM at-rest encryption (minimum 16 characters, MUST differ from API_SECRET_KEY)
# Generate via: openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# [OPTIONAL] Console login username for password manager auto-fill compatibility (default: Nexus, case-sensitive; alias: NEXUS_USERNAME)
ADMIN_USERNAME=Nexus

# [OPTIONAL] Set to true when serving behind an HTTPS reverse proxy
COOKIE_SECURE=false

# [OPTIONAL] Default WebUI locale: en | fr | zh-CN
DEFAULT_LOCALE=en

# [OPTIONAL] Container timezone for scheduled tasks & notification timestamps (IANA name, e.g. UTC, Europe/Paris, Asia/Shanghai)
TZ=UTC

# [OPTIONAL] Backend log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# [OPTIONAL] Comma-separated reverse proxy IPs or CIDRs trusted for X-Forwarded-For / X-Real-IP (e.g. 127.0.0.1,172.16.0.0/12)
TRUSTED_PROXIES=

# [OPTIONAL] Non-root UID/GID to own /data (0700) and run ovh-nexus via su-exec (default 65532:65532)
PUID=65532
PGID=65532

# [OPTIONAL] Go runtime soft memory ceiling & GC target percentage (defaults: 256MiB / 50)
GOMEMLIMIT=256MiB
GOGC=50

# [OPTIONAL] Override Docker image tag (defaults to elleryhe/ovh-nexus:latest)
# DOCKER_IMAGE=elleryhe/ovh-nexus:1.4.0

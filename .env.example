# ==============================================================================
# OVH Nexus — Environment Configuration Template
# Copy this file to .env and set a strong API_SECRET_KEY before starting:
#   cp .env.example .env
# ==============================================================================

# [REQUIRED] Console login password & API authentication key (minimum 12 chars)
# Generate one via: openssl rand -hex 24
API_SECRET_KEY=

# [OPTIONAL] Default WebUI locale: en | fr | zh-CN
DEFAULT_LOCALE=en

# [OPTIONAL] Set to true when serving behind an HTTPS reverse proxy
COOKIE_SECURE=false

# [OPTIONAL] Override Docker image tag (defaults to elleryhe/ovh-nexus:latest)
# DOCKER_IMAGE=elleryhe/ovh-nexus:1.0.0

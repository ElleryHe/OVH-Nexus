{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ovh-nexus-docs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ovh-nexus.ellery.me",
      "custom_domain": true
    }
  ]
}
